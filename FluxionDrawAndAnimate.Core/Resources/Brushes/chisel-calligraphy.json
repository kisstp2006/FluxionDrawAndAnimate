          "points": [
            { "x": 0, "y": 0 },
            { "x": 1, "y": 1 }
          ]
        }
      },
      "opacityBinding": {
        "sensor": "Pressure",
        "curve": {
          "points": [
            { "x": 0, "y": 0 },
            { "x": 1, "y": 1 }
          ]
        }
      }
    }
  }
