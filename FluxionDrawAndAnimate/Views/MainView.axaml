<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="using:FluxionDrawAndAnimate.Ui.Panels"
             xmlns:settings="using:FluxionDrawAndAnimate.Ui.Settings"
             xmlns:shell="using:FluxionDrawAndAnimate.Ui.Shell"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="FluxionDrawAndAnimate.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>

    <!-- Shell: title bar + page content area + bottom bar. Page views are created
         and cached in code-behind (MainView.axaml.cs) when ActivePage changes. -->
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource FluxBgPage}">

        <!-- Custom title bar (logo, menus, page tabs, actions) -->
        <Border Grid.Row="0"
                Background="{DynamicResource FluxBgPanel}"
                BorderBrush="{DynamicResource FluxBorder}"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding IsShellChromeVisible}">
            <shell:AppTitleBar />
        </Border>

        <!-- Active page content (swapped by code-behind) -->
        <ContentControl Grid.Row="1"
                        x:Name="PageContent"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- Status bar / bottom bar (registered items + status message) -->
        <Border Grid.Row="2"
                Background="{DynamicResource FluxBgPanel}"
                BorderBrush="{DynamicResource FluxBorder}"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding IsShellChromeVisible}">
            <shell:AppBottomBar />
        </Border>

        <!-- Settings modal
             Phone  → full-screen, no dim, back-button supported
             Desktop → centred card over dim backdrop -->
        <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsSettingsVisible}">
            <Border Background="#88000000"
                    IsVisible="{Binding !IsPhoneLayout}" />
            <settings:SettingsDialog
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
