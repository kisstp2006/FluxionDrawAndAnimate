<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://github.com/projektanker/icons.avalonia"
             xmlns:app="using:FluxionDrawAndAnimate"
             xmlns:shell="using:FluxionDrawAndAnimate.Presentation.Shell"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.Shell.AppTitleBar"
             x:DataType="vm:MainViewModel"
             Height="52">
    <Grid>
        <!-- Drag surface (sits behind content; captures pointer on empty space) -->
        <Border Background="Transparent"
                x:Name="DragSurface"
                PointerPressed="OnDragSurfacePointerPressed"
                DoubleTapped="OnDragSurfaceDoubleTapped" />

        <!-- Title bar layout: [logo+menus] | [page tabs center] | [actions right] -->
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- ── Left: logo + app name + dropdown menus ── -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <!-- Logo badge -->
                <Border Width="28" Height="28"
                        Background="{DynamicResource FluxAccent}"
                        CornerRadius="7"
                        Margin="0,0,8,0">
                    <TextBlock Text="F"
                               Foreground="{DynamicResource FluxAccentText}"
                               FontSize="17"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- App name — sourced from AppInfo so a version bump updates everywhere -->
                <TextBlock Text="{x:Static app:AppInfo.Name}"
                           Foreground="{DynamicResource FluxText}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />

                <!-- Registered menus — hidden on phone (too narrow for touch) -->
                <ItemsControl ItemsSource="{Binding ShellRegistry.Menus}"
                              IsVisible="{Binding !IsPhoneLayout}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:MenuDefinition">
                            <Button Content="{Binding Title}" Classes="menuBtn">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                                        <Border Background="{DynamicResource FluxBgPanel}"
                                                BorderBrush="{DynamicResource FluxBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                MinWidth="220">
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="shell:MenuItemDefinition">
                                                        <Panel>
                                                            <!-- Separator -->
                                                            <Border IsVisible="{Binding IsSeparator}"
                                                                    Height="1"
                                                                    Background="{DynamicResource FluxBorder}"
                                                                    Margin="8,3" />
                                                            <!-- Regular item -->
                                                            <Button IsVisible="{Binding !IsSeparator}"
                                                                    Command="{Binding Command}"
                                                                    CommandParameter="{Binding CommandParameter}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="10,7"
                                                                    CornerRadius="5">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{DynamicResource FluxText}"
                                                                               FontSize="13" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding ShortcutText}"
                                                                               Foreground="{DynamicResource FluxTextMuted}"
                                                                               FontSize="12"
                                                                               IsVisible="{Binding ShortcutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                               Margin="24,0,0,0" />
                                                                </Grid>
                                                            </Button>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Center: registered page tabs (hidden on phone to save space) ── -->
            <ListBox Grid.Column="1"
                     Classes="pageTabs"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !IsPhoneLayout}"
                     ItemsSource="{Binding ShellRegistry.Pages}"
                     SelectedItem="{Binding ActivePage}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="shell:PageDefinition">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ── Right: registered action buttons ── -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                <ItemsControl ItemsSource="{Binding ShellRegistry.Actions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shell:TitleBarActionDefinition">
                            <!-- Two overlapping buttons; only one visible based on IsPrimary -->
                            <Panel>
                                <Button Classes="icon primary"
                                        Command="{Binding Command}"
                                        IsVisible="{Binding IsPrimary}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:Icon Value="{Binding Icon}" FontSize="14"
                                                    IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="icon"
                                        Command="{Binding Command}"
                                        IsVisible="{Binding !IsPrimary}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:Icon Value="{Binding Icon}" FontSize="14"
                                                    IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding Title}"
                                                   IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
