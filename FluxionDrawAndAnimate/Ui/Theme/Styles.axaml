<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared Fluxion control styles. Class names are composable:
        e.g. Classes="action primary" = action sizing + accent colours,
        Classes="icon primary" = compact sizing + accent colours.
    -->

    <!-- Text -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
    </Style>

    <!-- Buttons: base look shared by all Fluxion button classes -->
    <Style Selector="Button.icon, Button.action, Button.primary">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Compact icon / toolbar button -->
    <Style Selector="Button.icon">
        <Setter Property="MinWidth" Value="42" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource FluxBgControl}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
    </Style>

    <!-- Standard secondary action button -->
    <Style Selector="Button.action">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Background" Value="{DynamicResource FluxBgControl}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
    </Style>

    <!-- Accent / primary colours (composable on top of icon or action) -->
    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="Button.icon.primary">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <!-- Hover / press feedback -->
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter,
                     Button.action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource FluxBgPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource FluxCornerRadius}" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource FluxBgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource FluxCornerRadius}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox.input, ComboBox.input">
        <Setter Property="Background" Value="{DynamicResource FluxBgInput}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
        <Setter Property="CornerRadius" Value="{DynamicResource FluxCornerRadiusMd}" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Home search: borderless TextBox hosted inside a custom Border.
         Suppresses the default focus chrome so the outer Border remains the
         only visual frame, keeps text vertically centered, and uses a larger,
         readable font size. -->
    <Style Selector="TextBox.searchField">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="TextBox.searchField /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.searchField:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.searchField:focus /template/ Border#PART_FocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Outer container for the home search bar; lifts the border on focus so
         the field clearly reacts without reintroducing the default TextBox chrome. -->
    <Style Selector="Border.searchFieldHost">
        <Setter Property="Background" Value="{DynamicResource FluxBgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluxBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.searchFieldHost:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource FluxAccent}" />
        <Setter Property="Background" Value="{DynamicResource FluxBgInput}" />
    </Style>

    <!-- Segmented control (multi-option pill selector) -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource FluxBgInput}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
    </Style>

    <!-- Color swatch selector -->
    <Style Selector="ListBox.colorSwatches">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.colorSwatches ListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="50" />
    </Style>
    <Style Selector="ListBox.colorSwatches ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Settings dialog sidebar item -->
    <Style Selector="Button.settingsNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.settingsNavItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
    </Style>
    <Style Selector="Button.settingsNavItem.navActive /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
    </Style>
    <Style Selector="Button.settingsNavItem.navActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Settings row label / description — use font-scale tokens -->
    <Style Selector="TextBlock.settingLabel">
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
        <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeMD}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.settingDesc">
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeSM}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Apply font scale to common text classes too -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeSM}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FluxFontSizeXS}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
    </Style>

    <!-- Home page sidebar navigation items -->
    <Style Selector="Button.navItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
    </Style>
    <Style Selector="Button.navItem.navActive /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
    </Style>
    <Style Selector="Button.navItem.navActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Status bar: compact icon/text button -->
    <Style Selector="Button.statusBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.statusBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
    </Style>

    <!-- Title bar: menu button (File / Edit / View / Help) -->
    <Style Selector="Button.menuBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.menuBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource FluxText}" />
    </Style>

    <!-- Title bar: page navigation tabs -->
    <Style Selector="ListBox.pageTabs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.pageTabs ListBoxItem">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluxTextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.pageTabs ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
    </Style>
    <Style Selector="ListBox.pageTabs ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="ListBox.pageTabs ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Phone horizontal tool strip (row of touch-friendly tool buttons) -->
    <Style Selector="ListBox.phoneToolStrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.phoneToolStrip ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.phoneToolStrip ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
    </Style>
    <Style Selector="ListBox.phoneToolStrip ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FluxAccentText}" />
    </Style>

    <!-- Tool rail (editor, vertical icon column) -->
    <Style Selector="ListBox.toolRail">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.toolRail ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.toolRail ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource FluxBgElevated}" />
    </Style>

    <!-- Frame strip (editor timeline) -->
    <Style Selector="ListBox.frameStrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.frameStrip ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.frameStrip ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource FluxAccent}" />
    </Style>

    <!-- Card list (project manager - selection outlines the card) -->
    <Style Selector="ListBox.cardList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.cardList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.cardList ListBoxItem:selected,
                     ListBox.cardList ListBoxItem:pointerover">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cardList ListBoxItem:selected /template/ ContentPresenter,
                     ListBox.cardList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cardList ListBoxItem:selected /template/ Border,
                     ListBox.cardList ListBoxItem:pointerover /template/ Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.cardList ListBoxItem:selected Border.card">
        <Setter Property="BorderBrush" Value="{DynamicResource FluxAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</Styles>
