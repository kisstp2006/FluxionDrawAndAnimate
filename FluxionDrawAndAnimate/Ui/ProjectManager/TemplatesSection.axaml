<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pm="using:FluxionDrawAndAnimate.Ui.ProjectManager"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.TemplatesSection"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="16">
        <!-- Section header -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Start from a Template"
                       Foreground="{DynamicResource FluxText}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Classes="action"
                    Foreground="{DynamicResource FluxAccent}"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="View All Templates →"
                    MinHeight="32"
                    Padding="0"
                    FontSize="13" />
        </Grid>

        <!-- Horizontal scroll of template cards -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ListBox Classes="cardList"
                     ItemsSource="{Binding ProjectTemplates}"
                     SelectedItem="{Binding SelectedProjectTemplate}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="presentation:ProjectCard">
                        <pm:ProjectTemplateCard Width="148" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </StackPanel>
</UserControl>
