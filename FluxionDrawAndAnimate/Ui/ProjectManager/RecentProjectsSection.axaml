<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pm="using:FluxionDrawAndAnimate.Ui.ProjectManager"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.RecentProjectsSection"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="16">
        <!-- Section header -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Recent Projects"
                       Foreground="{DynamicResource FluxText}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Classes="action"
                    Content="View all"
                    MinHeight="32"
                    Padding="12,4"
                    FontSize="13"
                    IsVisible="{Binding HasRecentProjects}" />
        </Grid>

        <!-- Project grid -->
        <ItemsControl ItemsSource="{Binding FilteredRecentProjects}"
                      IsVisible="{Binding HasRecentProjects}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:ProjectCard">
                    <pm:ProjectRecentCard Margin="0,0,14,14" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <Border Classes="card"
                Padding="32"
                IsVisible="{Binding IsRecentProjectsEmpty}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="No projects yet"
                           Foreground="{DynamicResource FluxText}"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Create a project or open an existing .fluxion file."
                           Foreground="{DynamicResource FluxTextMuted}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
