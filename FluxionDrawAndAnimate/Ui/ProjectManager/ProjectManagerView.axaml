<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pm="using:FluxionDrawAndAnimate.Ui.ProjectManager"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectManagerView"
             x:DataType="vm:MainViewModel">
    <!--
        Styles/colours come from the shared theme (App.axaml -> Ui/Theme).
        Phone vs Wide arrangement is chosen by the shared responsive tier on
        the view model (no separate breakpoint logic here).
    -->
    <Grid Background="{DynamicResource FluxBgPage}">
        <!-- Page layouts -->
        <pm:ProjectManagerWideLayout IsVisible="{Binding IsHomeWideLayout}" />
        <pm:ProjectManagerPhoneLayout IsVisible="{Binding IsHomePhoneLayout}" />

        <!-- New Project dialog overlay -->
        <Grid IsVisible="{Binding IsNewProjectDialogVisible}">
            <Border Background="#88000000" />
            <!-- HorizontalAlignment=Stretch lets the dialog fill the available width.
                 On desktop the dialog's internal 480×680 Border keeps it compact;
                 on phone (no Width) it fills the full screen. -->
            <pm:NewProjectDialog
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="20" />
        </Grid>

        <!-- Project Details floating panel (wide layout only, right-aligned) -->
        <Grid IsVisible="{Binding IsProjectDetailsVisible}"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,16,16,16">
            <pm:ProjectDetailsPanel VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
