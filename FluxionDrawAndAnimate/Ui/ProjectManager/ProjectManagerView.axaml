<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pm="using:FluxionDrawAndAnimate.Ui.ProjectManager"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectManagerView"
             x:DataType="vm:MainViewModel">
    <!--
        Styles/colours come from the shared theme (App.axaml -> Ui/Theme).
        Phone vs Wide arrangement is chosen by the shared responsive tier on
        the view model (no separate breakpoint logic here).
    -->
    <Grid Background="{DynamicResource FluxBgPage}">
        <!-- Page layouts -->
        <pm:ProjectManagerWideLayout IsVisible="{Binding IsHomeWideLayout}" />
        <pm:ProjectManagerPhoneLayout IsVisible="{Binding IsHomePhoneLayout}" />

        <!-- New Project dialog overlay
             Phone  → full-screen (no dim, AppDialogFrame fills the view)
             Desktop → centred card over dim backdrop -->
        <Grid IsVisible="{Binding IsNewProjectDialogVisible}">
            <Border Background="#88000000"
                    IsVisible="{Binding !IsPhoneLayout}" />
            <pm:NewProjectDialog
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Rename dialog overlay -->
        <Grid IsVisible="{Binding IsRenameDialogVisible}">
            <Border Background="#88000000"
                    IsVisible="{Binding !IsPhoneLayout}" />
            <pm:RenameProjectDialog
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>

        <!-- Project Details: phone layout uses a full-screen sheet, wide layout keeps a docked panel. -->
        <Grid IsVisible="{Binding IsProjectDetailsFullScreen}">
            <pm:ProjectDetailsPanel IsFullScreen="True"
                                    TopLevel.AutoSafeAreaPadding="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
        </Grid>

        <Grid IsVisible="{Binding IsProjectDetailsDockedVisible}"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Margin="0,16,16,16">
            <pm:ProjectDetailsPanel Width="320"
                                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
