<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectRecentCard"
             x:DataType="presentation:ProjectCard">
    <Border Classes="card"
            Width="210"
            ClipToBounds="True"
            Padding="0">
        <Grid RowDefinitions="128,Auto">

            <!-- Thumbnail area -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Border Background="{DynamicResource FluxBgElevated}" />
                <Image Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding HasThumbnail}" />
                <TextBlock Text="{Binding ThumbnailLabel}"
                           IsVisible="{Binding HasNoThumbnail}"
                           Foreground="{DynamicResource FluxTextMuted}"
                           FontSize="32" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Three-dot context menu -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,6,0" Padding="4,2"
                        Background="#66000000" Foreground="White"
                        CornerRadius="5" BorderThickness="0">
                    <icons:Icon Value="mdi-dots-horizontal" FontSize="14" />
                    <Button.Flyout>
                        <!-- x:CompileBindings="False" lets us access MainViewModel via ancestor
                             without being restricted to the ProjectCard x:DataType context. -->
                        <MenuFlyout Placement="BottomEdgeAlignedRight"
                                    x:CompileBindings="False">
                            <MenuItem Header="Open"
                                      Command="{Binding $parent[ListBox].DataContext.OpenSelectedRecentProjectCommand}">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-folder-open-outline" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Favourite"
                                      Command="{Binding $parent[ListBox].DataContext.ToggleFavoriteCommand}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-star-outline" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Duplicate"
                                      Command="{Binding $parent[ListBox].DataContext.DuplicateProjectCommand}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-content-copy" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Rename"
                                      Command="{Binding $parent[ListBox].DataContext.ShowRenameDialogCommand}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-pencil-outline" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Export">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-export-variant" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete">
                                <MenuItem.Icon>
                                    <icons:Icon Value="mdi-delete-outline" FontSize="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Card info -->
            <Border Grid.Row="1" Padding="12,10,12,12">
            <StackPanel Spacing="5">
                <!-- Title + badge -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource FluxText}"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Background="{Binding BadgeBrush}"
                            CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding HasBadge}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeLabel}"
                                   Foreground="White" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <!-- Canvas size -->
                <TextBlock Text="{Binding SizeLabel}"
                           Foreground="{DynamicResource FluxTextMuted}" FontSize="12" />
                <!-- Footer -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                    <TextBlock Text="{Binding UpdatedLabel}"
                               Foreground="{DynamicResource FluxTextMuted}" FontSize="11"
                               VerticalAlignment="Center" IsVisible="{Binding HasUpdatedLabel}" />
                    <icons:Icon Grid.Column="1" Value="mdi-cloud-outline"
                               Foreground="{DynamicResource FluxTextMuted}" FontSize="13"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
