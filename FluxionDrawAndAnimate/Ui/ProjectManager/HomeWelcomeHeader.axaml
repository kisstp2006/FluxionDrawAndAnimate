<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.HomeWelcomeHeader"
             x:DataType="vm:MainViewModel">
    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Foreground="{DynamicResource FluxText}"
                       FontSize="26"
                       FontWeight="Bold">
                <Run Text="Welcome back, " />
                <Run Text="{Binding HomePageRegistry.WelcomeName}" />
            </TextBlock>
            <TextBlock Text="{Binding HomePageRegistry.WelcomeEmoji}"
                       FontSize="26"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding HomePageRegistry.WelcomeSubtitle}"
                   Foreground="{DynamicResource FluxTextMuted}"
                   FontSize="14" />
    </StackPanel>
</UserControl>
