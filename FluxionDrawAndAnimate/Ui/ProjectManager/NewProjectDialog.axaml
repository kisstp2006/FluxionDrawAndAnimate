<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://github.com/projektanker/icons.avalonia"
             xmlns:pm="using:FluxionDrawAndAnimate.Ui.ProjectManager"
             xmlns:shared="using:FluxionDrawAndAnimate.Ui.Shared"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.NewProjectDialog"
             x:DataType="vm:MainViewModel">
    <shared:AppDialogFrame Title="New Project"
                           Subtitle="Configure your canvas and animation settings"
                           DialogIcon="mdi-plus-circle-outline"
                           CloseCommand="{Binding CloseNewProjectDialogCommand}"
                           IsPhoneLayout="{Binding IsPhoneLayout}"
                           MaxDialogWidth="480">
        <!-- Body -->
        <pm:NewProjectForm />

        <!-- Footer -->
        <shared:AppDialogFrame.FooterContent>
            <Grid ColumnDefinitions="*,Auto" MinHeight="64" VerticalAlignment="Stretch">
                <Button Classes="action"
                        Command="{Binding CloseNewProjectDialogCommand}"
                        Content="Cancel"
                        Padding="14,10" FontSize="13"
                        MinHeight="44"
                        VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding CreateProjectCommand}"
                        Padding="20,10" FontSize="13"
                        MinHeight="44"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:Icon Value="mdi-plus" FontSize="14" />
                        <TextBlock Text="Create Project" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </shared:AppDialogFrame.FooterContent>
    </shared:AppDialogFrame>
</UserControl>
