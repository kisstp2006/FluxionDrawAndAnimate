<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:FluxionDrawAndAnimate"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectBrandHeader">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
        <Border Width="46" Height="46"
                Background="{DynamicResource FluxAccent}"
                CornerRadius="10">
            <TextBlock Text="F"
                       Foreground="{DynamicResource FluxAccentText}"
                       FontSize="28" FontWeight="Black"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Static app:AppInfo.Name}"
                       Foreground="{DynamicResource FluxText}"
                       FontSize="28" FontWeight="Bold" />
            <TextBlock Text="{x:Static app:AppInfo.Tagline}"
                       Foreground="{DynamicResource FluxTextMuted}"
                       FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
