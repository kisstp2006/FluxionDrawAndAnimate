<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectTemplateCard"
             x:DataType="presentation:ProjectCard">
    <Border Classes="card" ClipToBounds="True" Padding="0" Cursor="Hand">
        <Grid RowDefinitions="90,Auto">
            <!-- Preview -->
            <Grid Grid.Row="0" ClipToBounds="True">
                <Border Background="{DynamicResource FluxBgElevated}" />
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                <Grid IsVisible="{Binding HasNoThumbnail}">
                    <Border Background="{DynamicResource FluxBgInput}" />
                    <TextBlock Text="{Binding ThumbnailLabel}"
                               Foreground="{DynamicResource FluxTextMuted}"
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Border IsVisible="{Binding HasBadge}"
                        Background="{DynamicResource FluxAccent}"
                        CornerRadius="5" Padding="6,3"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
                    <TextBlock Text="{Binding BadgeLabel}"
                               Foreground="{DynamicResource FluxAccentText}"
                               FontSize="10" FontWeight="SemiBold" />
                </Border>
            </Grid>
            <!-- Info -->
            <Border Grid.Row="1" Padding="10,8,10,10">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource FluxText}"
                           FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource FluxTextMuted}" FontSize="11">
                    <Run Text="{Binding SizeLabel}" />
                    <Run Text="  •  " />
                    <Run Text="{Binding Subtitle}" />
                </TextBlock>
            </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
