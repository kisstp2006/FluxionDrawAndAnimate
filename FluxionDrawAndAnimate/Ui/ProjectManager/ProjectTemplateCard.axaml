<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             x:Class="FluxionDrawAndAnimate.Ui.ProjectManager.ProjectTemplateCard"
             x:DataType="presentation:ProjectCard">
    <Border Classes="card" Padding="12" MinHeight="246">
        <Grid RowDefinitions="118,*">
            <Border Background="{DynamicResource FluxBgElevated}"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding HasThumbnail}" />
                    <Grid IsVisible="{Binding HasNoThumbnail}">
                        <Border Background="{DynamicResource FluxBgInput}" />
                        <TextBlock Text="{Binding ThumbnailLabel}"
                                   Foreground="{DynamicResource FluxText}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border IsVisible="{Binding HasBadge}"
                            Background="{DynamicResource FluxAccent}"
                            CornerRadius="6"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8">
                        <TextBlock Text="{Binding BadgeLabel}"
                                   Foreground="{DynamicResource FluxAccentText}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  Margin="2,12,2,0">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource FluxText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Subtitle}"
                           Foreground="{DynamicResource FluxTextMuted}"
                           FontSize="14"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2"
                           Text="{Binding SizeLabel}"
                           Foreground="{DynamicResource FluxTextMuted}"
                           FontSize="14"
                           Margin="0,10,0,0" />
                <TextBlock Grid.Row="3"
                           Text="{Binding TimingLabel}"
                           Foreground="{DynamicResource FluxTextMuted}"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
