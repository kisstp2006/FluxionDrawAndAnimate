<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FluxionDrawAndAnimate.Ui.Settings.Components.SettingsDropdownRow"
             x:Name="root">
    <Grid ColumnDefinitions="*,Auto" MinHeight="44" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Classes="settingLabel" Text="{Binding Label, ElementName=root}" />
            <TextBlock Classes="settingDesc"
                       Text="{Binding Description, ElementName=root}"
                       IsVisible="{Binding Description, ElementName=root,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Options, ElementName=root}"
                  SelectedItem="{Binding SelectedOption, ElementName=root}"
                  MinWidth="{Binding DropdownWidth, ElementName=root}"
                  Background="{DynamicResource FluxBgInput}"
                  BorderBrush="{DynamicResource FluxBorder}"
                  Foreground="{DynamicResource FluxText}"
                  FontSize="13"
                  VerticalAlignment="Center" />
    </Grid>
</UserControl>
