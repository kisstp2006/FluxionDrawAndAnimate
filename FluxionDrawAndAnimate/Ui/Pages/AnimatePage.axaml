<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FluxionDrawAndAnimate.Ui.Pages.AnimatePage"
             Background="{DynamicResource FluxBgPage}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="Animate" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource FluxText}" HorizontalAlignment="Center" />
        <TextBlock Text="Coming soon — timeline, onion skin, playback." Foreground="{DynamicResource FluxTextMuted}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
