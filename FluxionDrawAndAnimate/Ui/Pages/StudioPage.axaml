<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="https://github.com/projektanker/icons.avalonia"
             xmlns:local="using:FluxionDrawAndAnimate.Ui.Pages"
             xmlns:animation="using:FluxionDrawAndAnimate.Core.Animation"
             xmlns:controls="using:FluxionDrawAndAnimate.Controls"
             xmlns:panels="using:FluxionDrawAndAnimate.Ui.Panels"
             xmlns:presentation="using:FluxionDrawAndAnimate.Presentation"
             xmlns:vm="using:FluxionDrawAndAnimate.ViewModels"
             x:Class="FluxionDrawAndAnimate.Ui.Pages.StudioPage"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource FluxBgPage}">
    <!-- Root: secondary toolbar (Auto) + main content (*) -->
    <Grid RowDefinitions="Auto,*">

        <!-- Studio secondary toolbar — in front of canvas (ZIndex > canvas default 0) -->
        <local:StudioToolbar Grid.Row="0"
                             ZIndex="10"
                             IsVisible="{Binding !IsPhoneLayout}" />

        <Panel Grid.Row="1">

            <!-- ══════════════════════════════════════════════════════
                 DESKTOP / TABLET  —  tool panel | canvas | props
            ══════════════════════════════════════════════════════ -->
            <Grid IsVisible="{Binding !IsPhoneLayout}"
                  ColumnDefinitions="Auto,*,Auto">

                <!-- Tool panel (left) — ZIndex brings it in front of the canvas -->
                <Border Grid.Column="0"
                        ZIndex="10"
                        Background="{DynamicResource FluxBgPanel}"
                        BorderBrush="{DynamicResource FluxBorder}"
                        BorderThickness="0,0,1,0"
                        Width="160">
                    <local:StudioToolPanel />
                </Border>

                <!-- Canvas (center) — ClipToBounds prevents any transform overflow -->
                <controls:DrawingCanvasControl Grid.Column="1"
                                               ZIndex="0"
                                               ClipToBounds="True"
                                               x:Name="MainCanvas"
                                               Project="{Binding Project}"
                                               ActiveFrameIndex="{Binding SelectedFrameIndex}"
                                               ActiveLayerIndex="{Binding SelectedLayerIndex}"
                                               BrushColor="{Binding BrushColor}"
                                               BrushSize="{Binding BrushSize}"
                                               ActiveToolKind="{Binding ActiveToolKind}"
                                               BrushSettings="{Binding ActiveBrushSettings}"
                                               ShowOnionSkin="{Binding ShowOnionSkin}"
                                               UndoStack="{Binding UndoStack}"
                                               CursorInfoCallback="{Binding CursorInfoCallback}"
                                               ScaleChangedCallback="{Binding ScaleChangedCallback}"
                                               FitToViewTrigger="{Binding FitToViewTrigger}" />

                <!-- Right properties panel -->
                <Border Grid.Column="2"
                        Classes="panel"
                        IsVisible="{Binding ShowSidePanel}"
                        Width="{Binding PropertiesPanelWidth}"
                        Margin="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Properties"
                                       Foreground="{DynamicResource FluxText}"
                                       FontWeight="SemiBold" FontSize="16" />
                            <StackPanel Spacing="6">
                                <TextBlock Classes="muted small" Text="Project" />
                                <TextBlock Text="{Binding Project.Width, StringFormat='Canvas: {0}'}" Foreground="{DynamicResource FluxText}" />
                                <TextBlock Text="{Binding Project.Height, StringFormat='Height: {0}'}" Foreground="{DynamicResource FluxText}" />
                                <ComboBox ItemsSource="{Binding AvailableFrameRates}"
                                          SelectedItem="{Binding Project.FramesPerSecond}"
                                          MinWidth="128"
                                          Background="{DynamicResource FluxBgInput}"
                                          Foreground="{DynamicResource FluxText}"
                                          BorderBrush="{DynamicResource FluxBorder}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="muted small" Text="Layers" />
                                <ItemsControl ItemsSource="{Binding Project.Layers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="animation:AnimationLayer">
                                            <Border Background="{DynamicResource FluxBgElevated}"
                                                    BorderBrush="{DynamicResource FluxBorder}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Margin="0,0,0,6" Padding="10">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FluxText}" />
                                                    <CheckBox Grid.Column="1" Content="Lock" IsChecked="{Binding IsLocked}" Foreground="{DynamicResource FluxTextMuted}" Margin="8,0" />
                                                    <CheckBox Grid.Column="2" Content="Vis" IsChecked="{Binding IsVisible}" Foreground="{DynamicResource FluxTextMuted}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <panels:SettingsPanel />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════
                 PHONE  —  full-bleed canvas + bottom tool strip
            ══════════════════════════════════════════════════════ -->
            <Grid IsVisible="{Binding IsPhoneLayout}"
                  RowDefinitions="*,Auto">

                <!-- Full-bleed canvas -->
                <controls:DrawingCanvasControl Grid.Row="0"
                                               Project="{Binding Project}"
                                               ActiveFrameIndex="{Binding SelectedFrameIndex}"
                                               ActiveLayerIndex="{Binding SelectedLayerIndex}"
                                               BrushColor="{Binding BrushColor}"
                                               BrushSize="{Binding BrushSize}"
                                               ActiveToolKind="{Binding ActiveToolKind}"
                                               BrushSettings="{Binding ActiveBrushSettings}"
                                               ShowOnionSkin="{Binding ShowOnionSkin}"
                                               UndoStack="{Binding UndoStack}"
                                               CursorInfoCallback="{Binding CursorInfoCallback}" />

                <!-- Compact horizontal tool strip + undo/redo -->
                <Border Grid.Row="1"
                        Background="{DynamicResource FluxBgPanel}"
                        BorderBrush="{DynamicResource FluxBorder}"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ListBox Classes="phoneToolStrip"
                                     ItemsSource="{Binding Tools}"
                                     SelectedItem="{Binding ActiveTool}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:ToolPreset">
                                        <Border Width="56" Height="56" CornerRadius="12" Padding="6">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Icon}"
                                                           Foreground="{DynamicResource FluxText}"
                                                           FontSize="22" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource FluxTextMuted}"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                        <!-- Undo / Redo on the right -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Classes="icon" Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding CanUndo}" MinWidth="44" MinHeight="44">
                                <icons:Icon Value="mdi-undo" FontSize="16" />
                            </Button>
                            <Button Classes="icon" Command="{Binding RedoCommand}"
                                    IsEnabled="{Binding CanRedo}" MinWidth="44" MinHeight="44">
                                <icons:Icon Value="mdi-redo" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Panel>
    </Grid>
</UserControl>
